{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Krishi Kendra Inventory",
  "version": "0.1.2",
  "identifier": "com.krishikendra.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Krishi Kendra Inventory",
        "maximized": true,
        "minWidth": 1024,
        "minHeight": 600,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFN0VBREIxNjI1NjgyQzYKUldUR2dsWmlzYTErM3NhNTA0VTQxM2V0YlpvTlVvekNQaSttVGlDYWNwTlRBdkNKN3NlVldNRmUK",
      "endpoints": [
        "https://github.com/globalcoretech/QubiStock/releases/latest/download/latest.json"
      ]
    }
  }
}

